# Public addresses: update only after new deployment is verified.
NEXT_PUBLIC_REGISTRAR_SEPOLIA=
# Optional Ethereum receipt deployment. Testnet addresses are built in after verification.
NEXT_PUBLIC_EVALUATION_REGISTRY_ETHEREUM=
# Server-only Graph deployment (do not use NEXT_PUBLIC for API keys).
NOMEN_SUBGRAPH_URL=
NOMEN_SUBGRAPH_KEY=
# Separate Arc Testnet catalog index; no key needed for a public Studio endpoint.
NOMEN_ARC_SUBGRAPH_URL=
NOMEN_ARC_SUBGRAPH_KEY=
# Optional x402 payment recipient; snapshot endpoint remains free.
NOMEN_PAY_TO=
FACILITATOR_URL=https://x402.org/facilitator

# Enable only after replacement contracts, roles, resolver, root and a real claim are verified.
NEXT_PUBLIC_ENABLE_CLAIMS=false
NEXT_PUBLIC_SUBREGISTRY_SEPOLIA=
NEXT_PUBLIC_RESOLVER_SEPOLIA=
NEXT_PUBLIC_REGISTRAR_BLOCK=0
# Server-only DeepSeek key for agent discovery.
DEEPSEEK_API_KEY=
# Optional AI discovery override. Other providers use Vercel AI Gateway.
# NOMEN_DISCOVERY_MODEL=google/gemini-2.5-flash-lite
# AI_GATEWAY_API_KEY=  # server-side only, if OIDC is unavailable
